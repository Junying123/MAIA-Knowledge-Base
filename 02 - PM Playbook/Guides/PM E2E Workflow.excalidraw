    {
      "type": "text",
      "id": "text_4",
      "x": 400,
      "y": 800,
      "strokeColor": "#1e1e1e",
      "fontSize": 16,
      "fontFamily": 1,
      "text": "STAGE 5: SOW (Statement of Work)\n\nPM drafts SOW covering:\n- Scope (what's included and excluded)\n- Timeline and milestones\n- Deliverables\n- Commercial terms\n\nReview with Tech Lead, CTO, CEO\nClient may request tweaks \u2192 multiple SOW versions\nClient signs final SOW",
      "textAlign": "center",
      "verticalAlign": "middle",
      "opacity": 100,
      "roundness": null,
      "strokeWidth": 2,
      "containerId": "stage_4",
      "originalText": "STAGE 5: SOW (Statement of Work)\n\nPM drafts SOW covering:\n- Scope (what's included and excluded)\n- Timeline and milestones\n- Deliverables\n- Commercial terms\n\nReview with Tech Lead, CTO, CEO\nClient may request tweaks \u2192 multiple SOW versions\nClient signs final SOW"
    },
